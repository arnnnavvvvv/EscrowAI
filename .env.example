# Copy to .env and fill in. .env is gitignored.

# Groq — OpenAI-compatible endpoint, used for the plain-English verdict phrasing.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# GitHub — read PR diffs, post the verdict comment, hold the merge.
# Fine-grained PAT with Contents:read, Pull requests:read/write, Checks:write on the repo.
GITHUB_TOKEN=
GITHUB_REPO=arnnnavvvvv/EscrowAI
